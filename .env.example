# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (AI texting bot + lead scoring)
OPENAI_API_KEY=sk-...

# Twilio (dialer + SMS)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_PHONE_NUMBER=+1...
TWILIO_TWIML_APP_SID=AP...

# Google Sheets
GOOGLE_SERVICE_ACCOUNT_EMAIL=...
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-here

# Meta / Facebook
META_APP_SECRET=your-app-secret          # From Meta App → Settings → Basic
# Note: Per-agency page tokens + pixel IDs are stored in the meta_configs DB table
# so each agency can connect their own Facebook page
